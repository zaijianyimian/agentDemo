# Java business platform environment example.
# Agent/LLM/Memory/RAG/MCP/Skill configuration belongs to the Python service.

# ---------- MySQL ----------
MYSQL_URL=jdbc:mysql://mysql:3306/agent?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USERNAME=agent
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# ---------- PostgreSQL (Python) ----------
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# ---------- RabbitMQ ----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=agent
RABBITMQ_PASSWORD=replace-with-strong-password
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_EXCHANGE=agent_email
RABBITMQ_QUEUE_NAME=agent_email_queue
RABBITMQ_ROUTING_KEY=agent_email
DISPATCH_EXECUTION_QUEUE=agent.execution.requests
DISPATCH_RESULT_QUEUE=agent.execution.results
RABBITMQ_CONNECTION_TIMEOUT=5s

# ---------- Python Agent Engine ----------
GRAPH_ENABLED=true
# Python 与 Java 的内部调用共享密钥。
# 未配置时 Java 的 /internal/** 一律返回 503（fail-closed），日程将无法由
# AI 链路创建；Python 侧也会拒绝启动网关。必须 >= 32 字符，两侧保持一致。
GRAPH_INTERNAL_TOKEN=replace-with-shared-internal-token-at-least-32-chars
# 内部调用签名允许的时钟偏移秒数。
GRAPH_INTERNAL_TOKEN_TOLERANCE_SECONDS=300

# Model configuration is consumed only by the Python container.
CHAT_MODEL=your-model-name
CHAT_API_KEY=replace-with-model-api-key
CHAT_BASE_URL=https://api.openai.com/v1

# ---------- Email ----------
EMAIL_LISTENER_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_SSL_ENABLED=true
SMTP_FROM_NAME=Agent Demo

# ---------- Schedule / Task ----------
SCHEDULE_ENABLED=true
SCHEDULE_STORAGE_PATH=./data/schedules
SCHEDULE_USER_EMAIL=replace-with-schedule-user-email
TASK_SCHEDULER_ENABLED=true
TASK_SCHEDULER_SCAN_INTERVAL_SECONDS=1
TASK_SCHEDULER_BATCH_SIZE=50
TASK_EXECUTOR_POOL_SIZE=5
TASK_EXECUTOR_MAX_POOL_SIZE=10
TASK_EXECUTOR_QUEUE_CAPACITY=200
TASK_EXECUTOR_KEEP_ALIVE_SECONDS=60
TASK_EXECUTOR_AWAIT_SECONDS=60

# ---------- File / Backup ----------
FILE_UPLOAD_DIR=./data/documents
FILE_ALLOWED_TYPES=txt,md,pdf,doc,docx
BACKUP_DIRECTORY=./data/backups
BACKUP_KEEP_MOST_RECENT=10
BACKUP_RETENTION_DAYS=30

# ---------- Security ----------
JWT_SECRET=replace-with-jwt-secret-at-least-32-bytes
DATA_SECRET=replace-with-data-secret-at-least-32-bytes
SECURITY_ISSUER=agent-demo
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
