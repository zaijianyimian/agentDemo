# Sample environment file for the agentDemo container.
# Copy to `.env` (gitignored) and adjust values for your deployment.

# ---------- MySQL ----------
MYSQL_URL=jdbc:mysql://mysql:3306/agent?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USERNAME=agent
MYSQL_PASSWORD=replace-with-strong-password

# ---------- OpenAI-compatible Chat (LLM) ----------
OPENAI_API_KEY=replace-with-openai-compatible-chat-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# ---------- OpenAI-compatible Embedding ----------
# 启用后会替换默认 Ollama Embedding
OPENAI_EMBEDDING_ENABLED=false
OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_API_KEY=replace-with-openai-compatible-embedding-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-v3
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_EMBEDDING_TIMEOUT_SECONDS=30

# ---------- Ollama (默认 Embedding) ----------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# ---------- Qdrant ----------
QDRANT_HOST=qdrant
QDRANT_GRPC_PORT=6334
QDRANT_REST_PORT=6333
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_USE_TLS=false

# ---------- SMTP ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_SSL_ENABLED=true
SMTP_FROM_NAME=AI Agent

# ---------- Schedule ----------
SCHEDULE_USER_EMAIL=replace-with-schedule-user-email

# ---------- Security ----------
JWT_SECRET=replace-with-jwt-secret-at-least-32-bytes
DATA_SECRET=replace-with-data-secret-at-least-32-bytes
SECURITY_ISSUER=agent-demo

# ---------- OpenClaw Gateway ----------
OPENCLAW_GATEWAY_BASE_URL=http://openclaw:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-openclaw-gateway-token
OPENCLAW_GATEWAY_MODEL=openclaw
OPENCLAW_GATEWAY_HEALTH_TIMEOUT_SECONDS=3

# ---------- Optional integrations ----------
SEARCH_ENABLED=false
SEARCH_API_KEY=replace-with-search-api-key
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret